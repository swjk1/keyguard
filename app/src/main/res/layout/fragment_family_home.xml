<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent's home: one card per child, and a way to add another.

  Nothing on this screen is configurable - it answers "are they alright?" and nothing else.
  Each card says who, when their phone last checked in, a status in colour and words, and the
  most recent warning; everything else about that child is one tap away on their own page.

  Adding a child is a floating button rather than a card at the top. It is needed once per
  child, and a pairing card permanently occupying the top of the home screen made the app
  read as a setup wizard long after setup was over. With no children yet the button gives way
  to an empty state whose one action is the same thing.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/familyScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/scroll_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              The one state worth interrupting a clean screen for: a paired family whose
              parent phone cannot post a notification. Nothing else would ever say so.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alertsCard"
                style="@style/Widget.Keyguard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/status_pending_surface"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_sm">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_parent_alerts_off"
                        app:tint="@color/status_pending" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/parent_alerts_off_title"
                            android:textAppearance="@style/TextAppearance.Keyguard.Label"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/parent_alerts_off_body"
                            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alertsButton"
                        style="@style/Widget.Keyguard.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_alerts_turn_on" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/emptyState"
                layout="@layout/view_parent_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:visibility="gone" />

            <TextView
                android:id="@+id/familyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_sm"
                android:accessibilityHeading="true"
                android:text="@string/parent_family_heading"
                android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/childrenContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addChildFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_md"
        android:text="@string/parent_add_child_action"
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:backgroundTint="@color/accent"
        app:icon="@drawable/ic_parent_add"
        app:iconTint="@android:color/white" />
</FrameLayout>
