<?xml version="1.0" encoding="utf-8"?>
<!--
  Every child's warnings in one feed, newest first, grouped Today / Yesterday / Earlier.

  The Family tab answers "how is each child?"; this one answers "what happened today?" for a
  parent with more than one child, who would otherwise open each child's page in turn. Each
  entry opens the child it belongs to. The groups are built in code - a quiet day has no
  heading at all rather than a heading over nothing.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activityScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_parent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/feedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!--
          Restated under the feed because this is the screen where a parent is most likely to
          wonder what was actually written - and the answer is that nobody can see it.
        -->
        <TextView
            android:id="@+id/feedPrivacyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:text="@string/parent_feed_privacy_note"
            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
