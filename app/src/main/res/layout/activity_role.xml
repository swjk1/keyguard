<?xml version="1.0" encoding="utf-8"?>
<!--
  The role chooser: the first screen anyone sees, and the only one they see it on.

  It was programmatic views before, which was fine when it was a stopgap and is not fine as a
  first impression. Two cards, each with the consequence spelled out, because picking wrong here
  routes someone into the wrong half of the product and — on a supervised device — cannot be
  undone by them afterwards.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/role_heading"
            android:textAppearance="@style/TextAppearance.Keyguard.CardTitle"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/role_hint"
            android:textAppearance="@style/TextAppearance.Keyguard.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/childCard"
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_sm"
                    android:text="@string/role_child"
                    android:textAppearance="@style/TextAppearance.Keyguard.CardTitle"
                    app:drawableStartCompat="@drawable/ic_nav_protection" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/role_child_hint"
                    android:textAppearance="@style/TextAppearance.Keyguard.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/parentCard"
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_sm"
                    android:text="@string/role_parent"
                    android:textAppearance="@style/TextAppearance.Keyguard.CardTitle"
                    app:drawableStartCompat="@drawable/ic_nav_family" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/role_parent_hint"
                    android:textAppearance="@style/TextAppearance.Keyguard.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/roleLockedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Keyguard.Body"
            android:textColor="@color/warn_medium"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
