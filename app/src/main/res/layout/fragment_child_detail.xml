<?xml version="1.0" encoding="utf-8"?>
<!--
  One child's page, pushed from the Family and Activity tabs.

  Top to bottom, in the order a worried parent asks: who and is the phone still reporting
  (header); what has happened (the warning timeline); what the week looked like (the report,
  which used to be a tab of its own with a chip row to pick the child - it is about one child,
  so it lives on that child's page); and finally the device itself, with Unpair last and
  outlined in red, as far from the top of the page as it can be.

  The timeline and the report are built in code: both are a variable number of entries, and
  several report sections are correctly absent on a quiet week.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/detailAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_parent_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="E" />

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Keyguard.Hero"
                tools:text="Emu child" />

            <TextView
                android:id="@+id/detailLastSeen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Keyguard.Body"
                tools:text="Last seen 1 min ago" />

            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_parent_chip"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:textAppearance="@style/TextAppearance.Keyguard.Chip"
                tools:text="All clear this week" />
        </LinearLayout>

        <!-- Recent warnings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/parent_recent_warnings"
            android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs">

                <LinearLayout
                    android:id="@+id/timelineContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/timelineEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/timelineEmptyIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_parent_avatar"
                        android:backgroundTint="@color/status_ok_surface"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/status_ok" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/timelineEmptyTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/parent_timeline_empty_title"
                            android:textAppearance="@style/TextAppearance.Keyguard.Label" />

                        <TextView
                            android:id="@+id/timelineEmptyBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/parent_timeline_empty_body"
                            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/showAllButton"
                    style="@style/Widget.Keyguard.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:visibility="gone"
                    tools:text="Show all 18" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Report -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/parent_reports_heading"
            android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/periodToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/periodDay"
                style="@style/Widget.Keyguard.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/parent_report_daily" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/periodWeek"
                style="@style/Widget.Keyguard.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/parent_report_weekly" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/reportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- This device -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/parent_device_heading"
            android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/deviceRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/detailStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Keyguard.Body"
            android:textColor="@color/status_alert"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unpairButton"
            style="@style/Widget.Keyguard.DestructiveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/parent_remove_child"
            app:icon="@drawable/ic_parent_delete"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
