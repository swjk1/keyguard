<?xml version="1.0" encoding="utf-8"?>
<!--
  One navigable row: icon, title, optional subtitle, chevron.

  The shared building block of both apps' hub screens. The old UI had no way into a deeper
  screen - everything a section owned was on that section, which is why every tab was a long
  scroll of cards. A row that leads somewhere is what lets a screen show a summary and put the
  detail one tap away. Built through `Rows.add` rather than included by hand, so every row in
  the product has the same height, padding and touch target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:tint="@color/accent_icon"
        tools:src="@drawable/ic_nav_family" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Keyguard.Label"
            tools:text="Family" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint"
            tools:text="Supervised by your family" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_sm"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/on_surface_muted" />
</LinearLayout>
