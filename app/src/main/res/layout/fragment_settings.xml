<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent's settings: grouped rows, each leading to a screen or doing one thing.

  Everything configured once and then rarely touched lives here, one tap deep, so no other tab
  has to carry it. The rows are built in code (see Rows) so their subtitles can say the
  current state - the rules in force, whether alerts are on - without opening them.

  The destructive pair sits last, in the Account group, behind a confirmation for Delete.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
          Shown once, straight after an account is created or recovered. The server keeps no
          readable copy, so this card is the only chance a parent gets to write it down.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recoveryCard"
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_pending_surface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parent_recovery_title"
                    android:textAppearance="@style/TextAppearance.Keyguard.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/parent_recovery_body"
                    android:textAppearance="@style/TextAppearance.Keyguard.Body"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/recoveryCodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recoveryCopyButton"
                        style="@style/Widget.Keyguard.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_recovery_copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recoveryDoneButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/parent_recovery_done" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/parent_settings_family"
            android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/familyRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityHeading="true"
            android:text="@string/parent_settings_account"
            android:textAppearance="@style/TextAppearance.Keyguard.SectionHeader" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/accountRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settingsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Keyguard.Body"
            android:textColor="@color/status_alert"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
