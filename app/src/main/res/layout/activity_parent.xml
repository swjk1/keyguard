<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent app's shell.

  Two states, not one. Signed out, the whole screen is the sign-in panel and there is no
  navigation — there is nothing behind it to navigate to, and a bottom bar leading to four empty
  sections is a worse first impression than a single focused form. Signed in, the panel goes and
  the sections appear.

  The old screen put the policy editor — six radio groups and two checkboxes — directly above
  the activity feed, so every visit made a parent scroll past a settings form to reach the thing
  they opened the app for. Rules is now its own section, visited when a parent means to change
  something.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:titleTextColor="@color/on_surface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/sectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!--
      The signed-out state. A sibling of the section container rather than something inside it,
      so it covers the whole screen while it lasts.

      Wrapped in a FrameLayout rather than carrying the behaviour on the <include> itself:
      `include` only forwards `android:layout_*` attributes, so an `app:layout_behavior` written
      there is silently dropped and the panel renders underneath the toolbar. The wrapper holds
      the behaviour; the include holds the content.
    -->
    <FrameLayout
        android:id="@+id/authContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <include
            android:id="@+id/authPanel"
            layout="@layout/panel_parent_auth" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Keyguard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/nav_parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
