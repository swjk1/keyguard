<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent app's shell: a toolbar, one content area, and three tabs.

  Two states, not one. Signed out, the content area is the welcome panel and there is no
  navigation - there is nothing behind it to navigate to. Signed in, the panel goes and the
  tabs appear: Family (home), Activity (every child's warnings), Settings.

  Detail screens (a child's page, Add a child, Warning rules, Caregivers) are pushed into the
  same container over the tab they were opened from, and the bottom bar hides while one is
  showing - a detail belongs to the tab underneath it, and a tab bar under a child's page
  would offer a way to leave it that the back button then has to explain.

  A vertical LinearLayout rather than the CoordinatorLayout this used to be. The bottom bar
  used to float over the content, so every screen had to pad its last card by the bar's
  height; stacked, the content simply ends where the bar begins, and the Family tab's
  floating button sits above the bar instead of behind it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationContentDescription="@string/parent_navigate_up"
        app:navigationIconTint="@color/on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/on_surface" />

    <!--
      Shown while a load the parent asked for is in flight (first load, the Refresh action).
      Not for the Add child screen's background polling, which would otherwise flicker a bar
      across the top every four seconds.
    -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loadingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/accent"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/sectionContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The signed-out state. Covers the content area while it lasts. -->
        <include
            android:id="@+id/authPanel"
            layout="@layout/panel_parent_auth"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Keyguard.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/nav_parent" />
</LinearLayout>
