<?xml version="1.0" encoding="utf-8"?>
<!--
  One numbered setup step inside the home hero card.

  A finished step keeps its row, with a tick in place of its number, rather than disappearing:
  a checklist that empties itself leaves someone unable to confirm they did the thing, and the
  home screen is exactly where people come back to confirm it. Only the next step shows its
  hint, so the card says one thing to do rather than three.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:id="@+id/stepBadge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_disc">

        <TextView
            android:id="@+id/stepNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/stepCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Keyguard.Label" />

        <TextView
            android:id="@+id/stepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
