<?xml version="1.0" encoding="utf-8"?>
<!--
  The Keyguard keyboard: the older way to run Keyguard, kept as an option.

  One card to turn it on, and - only once it is on - one card to size it, with the real
  keyboard and its warning strip as the preview. Seven sliders for a keyboard nobody uses was
  noise on the old Look tab; here they only appear for someone who has chosen it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_keyboard"
                        app:tint="@color/accent_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/keyboard_card_title"
                            android:textAppearance="@style/TextAppearance.Keyguard.CardTitle" />

                        <TextView
                            android:id="@+id/keyboardStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Keyguard.OptionHint" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/protection_keyboard_hint"
                    android:textAppearance="@style/TextAppearance.Keyguard.Body" />

                <TextView
                    android:id="@+id/disclosureFirstText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/keyboard_disclosure_first"
                    android:textAppearance="@style/TextAppearance.Keyguard.OptionHint"
                    android:textColor="@color/status_pending"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enableButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:textColor="@color/button_text_accent"
                    app:backgroundTint="@color/button_tonal_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/setup_enable_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="@color/button_text_accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_switch_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/keyboardSizingCard"
            style="@style/Widget.Keyguard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/appearance_keyboard_heading"
                    android:textAppearance="@style/TextAppearance.Keyguard.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/appearance_keyboard_hint"
                    android:textAppearance="@style/TextAppearance.Keyguard.Body" />

                <LinearLayout
                    android:id="@+id/previewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@color/keyboard_background"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/keyboardControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autocorrectSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:minHeight="48dp"
                    android:text="@string/appearance_autocorrect"
                    android:textAppearance="@style/TextAppearance.Keyguard.Label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hapticsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/appearance_haptics"
                    android:textAppearance="@style/TextAppearance.Keyguard.Label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
