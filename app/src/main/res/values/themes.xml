<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Keyguard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <!--
          Set explicitly because `colorPrimary` is overridden. Material3's dark palette pairs a
          *light* primary (tone 80) with a dark `colorOnPrimary` (tone 20); `@color/accent` is
          #1D4ED8, a dark blue, and has no night variant. Inheriting the M3 default therefore
          painted dark text on a dark blue fill — the "Sign in" button on the parent screen was
          barely legible on a real device in dark mode. White is correct against this accent in
          both themes.
        -->
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/card_surface</item>
    </style>

    <!--
      Shared card styling.

      Every grouping in the app is one of these, so the visual weight of "this is a section" is
      decided once. A stroke plus a flat fill rather than an elevation shadow: shadows on a
      light grey ground look like smudges, and the stroke reads the same in both themes.
    -->
    <style name="Widget.Keyguard.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
    </style>

    <!-- A card's title. One weight, one size, everywhere. -->
    <style name="TextAppearance.Keyguard.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Supporting copy under a title, and most body text. -->
    <style name="TextAppearance.Keyguard.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- The label above a control. Darker than body, so a setting reads as a thing to change. -->
    <style name="TextAppearance.Keyguard.Label" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- The one-line explanation under a radio option. -->
    <style name="TextAppearance.Keyguard.OptionHint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface_muted</item>
    </style>

    <style name="Widget.Keyguard.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/card_surface</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
