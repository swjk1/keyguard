<?xml version="1.0" encoding="utf-8"?>
<!--
  The child app's hub-and-detail screens.

  Kept apart from strings.xml so the child, parent and overlay redesigns can land in parallel
  without fighting over one file. The wording rule is the same one the overlay strings state:
  the child is the reader. Short sentences, second person, and never a claim about what an
  adult can or cannot see that the code in family/ does not enforce.
-->
<resources>
    <!-- ==================== Home ==================== -->
    <string name="home_title_setup">Finish setting up</string>
    <string name="home_section_stats">Since you started</string>
    <string name="home_section_settings">Settings</string>

    <string name="home_stat_shown">Warnings</string>
    <string name="home_stat_changed">Changed</string>
    <string name="home_stat_sent">Sent anyway</string>

    <!-- The numbered setup steps inside the hero card. -->
    <string name="home_step_disclosure">Read what Keyguard can see</string>
    <string name="home_step_disclosure_hint">Takes a minute. Nothing else turns on until you have.</string>
    <!-- Primary button labels, one per next step. -->
    <string name="home_action_disclosure">Read it now</string>
    <string name="home_action_accessibility">Open accessibility settings</string>
    <string name="home_action_overlay">Allow warnings to show</string>
    <string name="home_action_enable_keyboard">Open keyboard settings</string>
    <string name="home_action_choose_keyboard">Switch to the Keyguard keyboard</string>
    <!-- Content description on a step's number badge, e.g. "Step 2, done". -->
    <string name="home_step_badge_done">Step %1$d, done</string>
    <string name="home_step_badge_todo">Step %1$d</string>

    <!--
      The family line on home. Three versions because the review scope is the fact that
      changes, and a line that said "never your messages" while full review was on would be a
      lie told to a child about what an adult can read.
    -->
    <string name="home_family_title">Your family can see some things</string>
    <string name="home_family_concerning">Warning types, never your messages</string>
    <string name="home_family_themes">Warning types and weekly topics, never your messages</string>
