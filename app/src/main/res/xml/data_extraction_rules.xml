<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is eligible for cloud backup or device transfer. There is no user content to
  preserve, and settings are cheap to re-pick.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
