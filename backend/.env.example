# Copy to .env.local for local dev, or set via `vercel env add` for deployments.

# Signs anonymous per-install tokens. Generate with: openssl rand -base64 32
# Rotating this invalidates every issued token; clients re-register automatically.
KEYGUARD_TOKEN_SECRET=

# AI Gateway model ids. Plain "provider/model" strings route through the Gateway, so these
# can be changed without a code change - which is what lets the benchmark compare tiers.
KEYGUARD_MODEL=anthropic/claude-haiku-4.5
KEYGUARD_ESCALATION_MODEL=anthropic/claude-sonnet-5

# Per-install caps. The server-side ceiling that makes the free tier's economics work;
# retune once the benchmark produces real per-user numbers.
KEYGUARD_FREE_DAILY_LIMIT=40
KEYGUARD_BURST_PER_MINUTE=12

# Family routes cost a Redis round trip, not an inference call, so they have their own budget.
# Pairing is capped far harder because it is the one route where the caller is guessing.
KEYGUARD_FAMILY_PER_MINUTE=30
KEYGUARD_PAIR_ATTEMPTS_PER_HOUR=10
KEYGUARD_AUTH_ATTEMPTS_PER_HOUR=20

# Upstash Redis, provisioned via the Vercel Marketplace.
#
# Two different failure modes hang off this, deliberately. The rate limiter fails OPEN without
# it - a misconfigured limiter must not take safety verification offline. Family storage fails
# CLOSED: with no store there is no policy to serve and nowhere to put an event, and a
# permissive answer would tell a child's device it is unsupervised while a parent believes
# otherwise. Supervision therefore does not work at all without these set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
